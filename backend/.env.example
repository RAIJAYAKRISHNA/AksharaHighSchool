# Origins allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database
DB_URL=jdbc:postgresql://localhost:5432/akshara_school
DB_USERNAME=akshara_app
DB_PASSWORD=put-your-akshara_app-password-here

# Authentication
# JWT_SECRET: a long random string, at least 32 characters (see the README for how to generate one)
JWT_SECRET=put-a-long-random-secret-here
# Minutes a login stays valid (optional, default 120)
JWT_EXPIRY_MINUTES=120

# The first admin account is created from these on the first start.
# Changing them later does NOT change an existing admin account.
ADMIN_EMAIL=put-the-admin-email-here
ADMIN_PASSWORD=put-a-strong-admin-password-here